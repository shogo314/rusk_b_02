%start Rusk
%title "Rusk beta prototype"
%line_comment "//"
%%
Rusk: { Statement };
Statement: Function | Return | ExternType | ExternFn | ExternSymbol | Let | Input | Output | If | For | While | Loop | Break | Continue | Block | Expr ';'^;
Function: 'fn'^ Identifier '('^ Parameters ')'^ [ '->'^ TypeName ] Block;
Return: 'return' [ Expr ] ';'^;
ExternType: 'extern'^ 'type'^ TypeName '{'^ Properties '}'^;
ExternFn: 'extern'^ 'fn'^ Identifier '('^ Parameters ')'^ [ '->'^ TypeName ] '{'^ Properties '}'^;
ExternSymbol: 'extern'^ 'symbol'^ Identifier '{'^ Properties '}'^;
Parameters: [ Parameter { ','^ Parameter } ];
Parameter: Identifier ':'^ TypeName;
TypeName: Identifier [ '<'^ TypeName '>'^ ];
Properties: { Property };
Property: Identifier ':'^ StringLiteral ','^;
Let: 'let'^ Identifier [ ':'^ TypeName ] [ LetInitOp Expr ] ';'^;
LetInitOp: ':=' | '=';
Input: 'in'^ InputItem { ','^ InputItem } ';'^;
InputItem: InputName { ','^ InputName } ':'^ TypeName;
InputName: Identifier [ '('^ ExprList ')'^ ];
Output: 'wt'^ ExprList ';'^;
Block: '{'^ { Statement } '}'^;
ExprList: [ Expr { ','^ Expr } ];
If: 'if'^ Expr Block [ 'else'^ Block ];
For: 'for'^ Identifier 'in'^ Expr Block [ 'else'^ Block ];
While: 'while'^ Expr Block [ 'else'^ Block ];
Loop: 'loop'^ Block;
Break: 'break' ';'^;
Continue: 'continue' ';'^;
Expr: Range [ AssignOp Expr ];
Range: LogicalOr [ '..'^ LogicalOr ];
LogicalOr: LogicalAnd { '||'^ LogicalAnd };
LogicalAnd: Compare { '&&'^ Compare };
Compare: Add [ CompareOp Add ];
CompareOp: '==' | '!=' | '<' | '<=' | '>' | '>=';
AssignOp: ':=' | '=' | '+=' | '-=' | '*=' | '/=' | '%=';
Add: Mul { AddOp Mul };
AddOp: '+' | '-';
Mul: Unary { MulOp Unary };
MulOp: '*' | '/' | '%';
Unary: UnaryOp Unary | Postfix;
Postfix: Primary { Suffix };
Suffix: Index | Method;
Method: '.'^ Identifier '('^ ExprList ')'^;
Index: '[' Expr ']'^;
UnaryOp: '+' | '-' | '!';
Array: '[' [ Expr ArrayTail ] ']'^;
ArrayTail: ';'^ Expr | { ','^ Expr };
Primary: Array | Literal | Identifier [ '('^ ExprList ')'^ ] | '('^ Expr ')'^;
Literal: IntLiteral | StringLiteral | CharLiteral | BoolLiteral;
BoolLiteral: 'true' | 'false';
IntLiteral: /[0-9]+/;
StringLiteral: /"(\\.|[^"\\])*"/;
CharLiteral: /'(\\.|[^'\\])'/;
Identifier: /[a-zA-Z_][a-zA-Z0-9_]*/;
